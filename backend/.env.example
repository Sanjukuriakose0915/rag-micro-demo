# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Configuration
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Vector Database (ChromaDB) Configuration
# When running `docker compose up -d`, connects to localhost:8001.
# If Docker is offline, automatically falls back to local disk persistence.
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=rag_documents

# Document Chunking Hyperparameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=4
